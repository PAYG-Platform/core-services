# ==============================================================================
# GLOBAL RUNTIME & SECURITY CONFIGURATION
# ==============================================================================
# Environment mode: 'development' allows embedded dev fallback RSA keys.
# In 'production', services strictly require verified RSA key files at the paths below.
ENVIRONMENT=development

# Cookie security settings (Set to 'True' in production when using HTTPS)
COOKIE_SECURE=False
COOKIE_HTTPONLY=False

# Asymmetric JWT RSA Keys (RS256)
# - IAM Service requires BOTH the Private Key (to sign tokens) and Public Key.
# - All other microservices require ONLY the Public Key (to verify tokens).
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem


# ==============================================================================
# POSTGRESQL GLOBAL DATABASE CONFIGURATION
# ==============================================================================
DB_USER=admin
DB_PASSWORD=super_secret_db_pass
DB_PORT=5432

# --- IAM Service Database (Authentication & Identity) ---
IAM_DB_HOST=postgres-iam
IAM_DB_NAME=iam_db
IAM_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${IAM_DB_HOST}:${DB_PORT}/${IAM_DB_NAME}

# --- Node Service Database (Servers, Inbounds & V2Ray Subscriptions) ---
NODE_DB_HOST=postgres-node
NODE_DB_NAME=node_db
NODE_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${NODE_DB_HOST}:${DB_PORT}/${NODE_DB_NAME}

# --- Billing Service Database (PAYG Ledger, Wallets, Top-ups & Refunds) ---
BILLING_DB_HOST=postgres-billing
BILLING_DB_NAME=billing_db
BILLING_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${BILLING_DB_HOST}:${DB_PORT}/${BILLING_DB_NAME}

# --- Support Service Database (Tickets, Chats & Attachment Metadata) ---
SUPPORT_DB_HOST=postgres-support
SUPPORT_DB_NAME=support_db
SUPPORT_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${SUPPORT_DB_HOST}:${DB_PORT}/${SUPPORT_DB_NAME}

# --- Notification Service Database (In-App Inbox, Preferences & SSE) ---
NOTIFICATION_DB_HOST=postgres-notification
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${NOTIFICATION_DB_HOST}:${DB_PORT}/${NOTIFICATION_DB_NAME}

# --- Config Service Database (System Branding & Maintenance Mode) ---
CONFIG_DB_HOST=postgres-config
CONFIG_DB_NAME=config_db
CONFIG_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${CONFIG_DB_HOST}:${DB_PORT}/${CONFIG_DB_NAME}

# --- Traffic & Metering Service Database (Usage Timeseries & ISP Attribution) ---
TRAFFIC_DB_HOST=postgres-traffic
TRAFFIC_DB_NAME=traffic_db
TRAFFIC_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${TRAFFIC_DB_HOST}:${DB_PORT}/${TRAFFIC_DB_NAME}


# ==============================================================================
# RABBITMQ ASYNCHRONOUS EVENT BUS
# ==============================================================================
# Message broker connection used for event-driven inter-service choreography
RMQ_HOST=rabbitmq
RMQ_PORT=5672
RMQ_USER=admin
RMQ_PASSWORD=super_secret_rmq_pass

# Composed AMQP connection URL
RABBITMQ_URL=amqp://${RMQ_USER}:${RMQ_PASSWORD}@${RMQ_HOST}:${RMQ_PORT}/


# ==============================================================================
# SHARED REDIS (RATE LIMITING & CONVERSATION STATE)
# ==============================================================================
# Caching, sliding-window rate limit counters, and Telegram Bot FSM wizard state
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Composed Redis connection URL
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}


# ==============================================================================
# SCHEDULER & PLATFORM CONFIGURATIONS
# ==============================================================================
# Background cron interval (in minutes) for 3X-UI traffic delta polling
SYNC_INTERVAL_MINUTES=5

# Official Telegram Bot handle (used for deep-linking: https://t.me/<username>?start=token)
TELEGRAM_BOT_USERNAME=PAYG_MNG_Bot

# Shared uploads directory name for receipt images and ticket attachments
UPLOAD_DIR=uploads


# ==============================================================================
# GENERAL OUTBOUND HTTP/HTTPS PROXY CONFIGURATION
# ==============================================================================
# Used by containers when making general outbound requests through an external proxy
PROXY_HOST=host.docker.internal
PROXY_PORT=10808

# Composed system proxy environment variables
HTTP_PROXY=http://${PROXY_HOST}:${PROXY_PORT}
HTTPS_PROXY=http://${PROXY_HOST}:${PROXY_PORT}
http_proxy=http://${PROXY_HOST}:${PROXY_PORT}
https_proxy=http://${PROXY_HOST}:${PROXY_PORT}


# ==============================================================================
# 3X-UI PANEL PROXY ROUTING CONFIGURATION
# ==============================================================================
# Set to 'true' to route 3X-UI panel API requests through proxy; 'false' for direct connection
USE_3XUI_PROXY=true

# 3X-UI specific proxy host and port
XUI_PROXY_HOST=host.docker.internal
XUI_PROXY_PORT=10808

# Composed 3X-UI HTTP proxy connection URL
XUI_HTTP_PROXY=http://${XUI_PROXY_HOST}:${XUI_PROXY_PORT}