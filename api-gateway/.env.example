PORT=8000

# Upstream microservice addresses.
# For All-in-One deployment: Leave as container hostnames (default).
# For 1-Service-Per-Server deployment: Replace with respective server IPs (e.g. WireGuard mesh 10.10.0.X:800X).
IAM_HOST=iam-service:8000
NODE_HOST=node-service:8000
BILLING_HOST=billing-service:8000
SUPPORT_HOST=support-service:8000
NOTIFICATION_HOST=notification-service:8000
CONFIG_HOST=config-service:8000
TRAFFIC_HOST=traffic-service:8000