# ==============================================================================
# GLOBAL RUNTIME & PROFILES CONFIGURATION
# ==============================================================================
ENVIRONMENT=production
IAM_PORT=8001

# Automatically activates the local postgres container on 'docker compose up'
# Set to COMPOSE_PROFILES="" if using Cloud DB (Neon / Supabase / RDS)
COMPOSE_PROFILES=local-db

# Cookie security settings (Set to 'True' in production behind HTTPS)
COOKIE_SECURE=True
COOKIE_HTTPONLY=True

# ==============================================================================
# CONTAINER IMAGE & BUILD CONFIGURATION (CI/CD vs SOURCE)
# ==============================================================================
IMAGE_NAME=ghcr.io/payg-vpn-platform/vpn-iam-service
IMAGE_TAG=latest

# Build context:
# - Use '..' and './iam-service/Dockerfile' if building within the monorepo root
# - Use '.' and 'Dockerfile' if building standalone
BUILD_CONTEXT=..
DOCKERFILE_PATH=./iam-service/Dockerfile

# ==============================================================================
# ASYMMETRIC JWT RSA KEYS (RS256)
# IAM Service is the authoritative identity authority and requires BOTH keys:
# 1. Private Key: Signs access tokens on login/register (Strict chmod 600).
# 2. Public Key: Verifies token signatures.
# ==============================================================================
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
DB_USER=admin
DB_PASSWORD=super_secret_db_pass
IAM_DB_NAME=iam_db

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DOCKER DATABASE (Default for separate server deployment)
# ------------------------------------------------------------------------------
DB_HOST=postgres-iam
DB_PORT=5432
DB_HOST_BIND=127.0.0.1:5432
DATABASE_URL=postgresql://admin:super_secret_db_pass@postgres-iam:5432/iam_db

# ------------------------------------------------------------------------------
# OPTION B: CLOUD POSTGRES / MANAGED DBAAS (Neon, Supabase, AWS RDS)
# Set COMPOSE_PROFILES="" above and uncomment your cloud connection string:
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-cool-fog-12345.eu-central-1.neon.tech/iam_db?sslmode=require

# ==============================================================================
# RABBITMQ ASYNCHRONOUS EVENT BROKER (REMOTE STANDALONE VPS OR CLOUD)
# ==============================================================================
# Literal connection URL (prevents unexpanded variable bugs)
RABBITMQ_URL=amqp://admin:super_secret_rmq_pass@10.10.0.10:5672/

# ==============================================================================
# SHARED REDIS (RATE LIMITING & CACHING - REMOTE STANDALONE OR CLOUD)
# ==============================================================================
# Literal connection URL (prevents unexpanded variable bugs)
REDIS_URL=redis://10.10.0.11:6379/0

# ==============================================================================
# CLIENT SETTINGS & COOLDOWN DEFAULTS
# ==============================================================================
# Cooldown duration in minutes for client self-service VPN toggle (0 = immediate)
CLIENT_STATUS_COOLDOWN_MINUTES=60

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_DIR=/app/logs

# ==============================================================================
# GENERAL OUTBOUND PROXY CONFIGURATION (OPTIONAL)
# ==============================================================================
# Uncomment ONLY if this server needs an outbound proxy to reach external services
# PROXY_HOST=host.docker.internal
# PROXY_PORT=10808
# HTTP_PROXY=http://${PROXY_HOST}:${PROXY_PORT}
# HTTPS_PROXY=http://${PROXY_HOST}:${PROXY_PORT}