# ==============================================================================
# GLOBAL RUNTIME CONFIGURATION
# ==============================================================================
ENVIRONMENT=production

# Container image metadata (used for CI/CD pulls from GHCR)
IMAGE_NAME=ghcr.io/payg-vpn-platform/vpn-telegram-service
IMAGE_TAG=latest

# Build context:
# - Use '..' and './telegram-service/Dockerfile' if building within the monorepo root
# - Use '.' and 'Dockerfile' if building standalone
BUILD_CONTEXT=..
DOCKERFILE_PATH=./telegram-service/Dockerfile

# ==============================================================================
# TELEGRAM APP CREDENTIALS (Required by Telethon MTProto)
# ==============================================================================
# Obtain these from https://my.telegram.org under 'API development tools'
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ==============================================================================
# BOT CREDENTIALS
# ==============================================================================
# The bot token created via @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=PAYG_VPN_Bot

# ==============================================================================
# BACKEND API GATEWAY & MICROSERVICES
# ==============================================================================
# Point to your API Gateway (e.g. WireGuard mesh IP or public domain)
API_GATEWAY_URL=http://10.10.0.20:8000
NOTIFICATION_SERVICE_URL=http://10.10.0.35:8005
IAM_SERVICE_URL=http://10.10.0.31:8001

# ==============================================================================
# ASYMMETRIC JWT RSA KEYS (RS256)
# ==============================================================================
# Path inside container to verify incoming tokens and mint 60s delegation tokens
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem

# ==============================================================================
# RABBITMQ ASYNCHRONOUS EVENT BROKER (REMOTE STANDALONE VPS OR CLOUD)
# ==============================================================================
# Used to listen for NOTIFICATION_CREATED, PAYMENT_PROCESSED, WALLET_EMPTY, etc.
RABBITMQ_URL=amqp://admin:super_secret_rmq_pass@10.10.0.10:5672/

# ==============================================================================
# SHARED REDIS (CONVERSATION FSM STATE & USER-CHAT ID MAPPING)
# ==============================================================================
# Connects to your standalone Redis server or Upstash / Cloud Redis
REDIS_URL=redis://10.10.0.11:6379/0

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_DIR=/app/logs

# ==============================================================================
# PROXY CONFIGURATION (OPTIONAL)
# ==============================================================================
# Uncomment ONLY if the server hosting this bot is in a country where Telegram is blocked
# PROXY_HOST=host.docker.internal
# PROXY_PORT=10808
# HTTP_PROXY=http://${PROXY_HOST}:${PROXY_PORT}
# HTTPS_PROXY=http://${PROXY_HOST}:${PROXY_PORT}