# ==============================================================================
# GLOBAL RUNTIME & PROFILES CONFIGURATION
# ==============================================================================
ENVIRONMENT=production
TRAFFIC_PORT=8007

# Automatically activates the local postgres container on 'docker compose up'
# Set to COMPOSE_PROFILES="" if using Cloud DB (Neon / Supabase / RDS)
COMPOSE_PROFILES=local-db

# ==============================================================================
# CONTAINER IMAGE & BUILD CONFIGURATION (CI/CD vs SOURCE)
# ==============================================================================
IMAGE_NAME=ghcr.io/payg-vpn-platform/vpn-traffic-service
IMAGE_TAG=latest

# Build context:
# - Use '..' and './traffic-service/Dockerfile' if building within the monorepo root
# - Use '.' and 'Dockerfile' if building standalone
BUILD_CONTEXT=..
DOCKERFILE_PATH=./traffic-service/Dockerfile

# Path to the RSA Public Key used to verify incoming JWT tokens (Asymmetric RS256)
# Traffic Service ONLY verifies client/admin tokens and NEVER requires the private key
JWT_PUBLIC_KEY_PATH=/keys/jwt_public.pem

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
DB_USER=admin
DB_PASSWORD=super_secret_db_pass
TRAFFIC_DB_NAME=traffic_db

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DOCKER DATABASE (Default for separate server deployment)
# ------------------------------------------------------------------------------
DB_HOST=postgres-traffic
DB_PORT=5432
DB_HOST_BIND=127.0.0.1:5438
DATABASE_URL=postgresql://admin:super_secret_db_pass@postgres-traffic:5432/traffic_db

# ------------------------------------------------------------------------------
# OPTION B: CLOUD POSTGRES / MANAGED DBAAS (Neon, Supabase, AWS RDS)
# Set COMPOSE_PROFILES="" above and uncomment your cloud connection string:
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-cool-fog-12345.eu-central-1.neon.tech/traffic_db?sslmode=require

# ==============================================================================
# RABBITMQ ASYNCHRONOUS EVENT BROKER (REMOTE STANDALONE VPS OR CLOUD)
# ==============================================================================
# Literal connection URL (prevents unexpanded variable bugs)
RABBITMQ_URL=amqp://admin:super_secret_rmq_pass@10.10.0.10:5672/

# ==============================================================================
# SHARED REDIS (RATE LIMITING & CACHING - REMOTE STANDALONE OR CLOUD)
# ==============================================================================
# Literal connection URL (prevents unexpanded variable bugs)
REDIS_URL=redis://10.10.0.11:6379/0

# ==============================================================================
# SCHEDULER & TRAFFIC SYNC SETTINGS
# ==============================================================================
# Background cron interval (in minutes) for polling 3X-UI panels for traffic delta
SYNC_INTERVAL_MINUTES=5

# Request timeout in seconds for 3X-UI panel API interactions
XUI_REQUEST_TIMEOUT=15.0

# Set to 'false' for direct connection; 'true' to tunnel panel requests through proxy
USE_3XUI_PROXY=false
# XUI_HTTP_PROXY=http://10.10.0.1:10808

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_DIR=/app/logs

# ==============================================================================
# GENERAL OUTBOUND PROXY CONFIGURATION (OPTIONAL)
# ==============================================================================
# Uncomment ONLY if this server needs an outbound proxy for external network calls
# PROXY_HOST=host.docker.internal
# PROXY_PORT=10808
# HTTP_PROXY=http://${PROXY_HOST}:${PROXY_PORT}
# HTTPS_PROXY=http://${PROXY_HOST}:${PROXY_PORT}